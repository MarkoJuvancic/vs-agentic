<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.Banners.QuestionCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:bvm="clr-namespace:VsAgentic.UI.ViewModels.Banners;assembly=VsAgentic.UI"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/Banners/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Per-option item templates. We can't keep both a radio and a
                 check ItemsControl in the visual tree (one collapsed, one
                 visible) bound to the same Options collection: the collapsed
                 RadioButtons still participate in their GroupName-driven
                 mutual-exclusion coordination, which clobbers the multi-select
                 CheckBox state — every CheckBox click would deselect the
                 previously-checked one as if they were radios. Instead, a
                 single ItemsControl swaps its ItemTemplate based on
                 MultiSelect, so only one control type is ever materialized. -->
            <DataTemplate x:Key="RadioOptionTemplate" DataType="{x:Type bvm:OptionViewModel}">
                <RadioButton Style="{StaticResource FluentRadioButtonStyle}"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                    <!-- The number is what makes Alt+N discoverable; without it
                         the shortcut is a secret. Grid, not StackPanel, so the
                         label still wraps in a narrow tool window. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding OrdinalLabel}"
                                   FontWeight="SemiBold"
                                   Opacity="0.6"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                       Opacity="0.78"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
            </DataTemplate>

            <DataTemplate x:Key="CheckOptionTemplate" DataType="{x:Type bvm:OptionViewModel}">
                <CheckBox Style="{StaticResource FluentCheckBoxStyle}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding OrdinalLabel}"
                                   FontWeight="SemiBold"
                                   Opacity="0.6"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                       Opacity="0.78"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </DataTemplate>

            <!-- "Other:" toggle templates — same reason: a collapsed
                 RadioButton with the question's GroupName still coordinates
                 with the (also collapsed) per-option radios in multi-select
                 mode, blanking selections. Swap a ContentControl's template
                 instead so only one control exists at a time. -->
            <DataTemplate x:Key="OtherRadioTemplate" DataType="{x:Type bvm:QuestionViewModel}">
                <RadioButton Style="{StaticResource FluentRadioButtonStyle}"
                             IsChecked="{Binding IsOtherSelected, Mode=TwoWay}"
                             GroupName="{Binding GroupName}"
                             VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OtherOrdinalLabel}"
                                   FontWeight="SemiBold"
                                   Opacity="0.6"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Other:"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DataTemplate>

            <DataTemplate x:Key="OtherCheckTemplate" DataType="{x:Type bvm:QuestionViewModel}">
                <CheckBox Style="{StaticResource FluentCheckBoxStyle}"
                          IsChecked="{Binding IsOtherSelected, Mode=TwoWay}"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OtherOrdinalLabel}"
                                   FontWeight="SemiBold"
                                   Opacity="0.6"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Other:"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
            </DataTemplate>

            <!-- Inner template for a single QuestionViewModel — bound to the
                 ContentControl in row 2. Hosts the question text, the
                 option list (radio or check, depending on MultiSelect),
                 and the "Other:" free-text row. -->
            <DataTemplate x:Key="QuestionTemplate" DataType="{x:Type bvm:QuestionViewModel}">
                <!-- DirectionalNavigation="Cycle" keeps the arrow keys inside
                     the question: Down walks the options, then the "Other"
                     toggle and its text box, then wraps round to the first
                     option instead of wandering off into the chat. -->
                <StackPanel Margin="12,6,12,6"
                            KeyboardNavigation.DirectionalNavigation="Cycle"
                            Loaded="QuestionRoot_Loaded">
                    <TextBlock Text="{Binding QuestionText}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               Margin="0,2,0,10"
                               TextWrapping="Wrap"/>

                    <!-- Focusable="False": a focusable ItemsControl is its own
                         tab stop, so walking back up out of the text box first
                         lands on the list as a whole and draws a dotted frame
                         around every option before reaching one of them. -->
                    <ItemsControl ItemsSource="{Binding Options}"
                                  Focusable="False"
                                  Margin="8,0,0,4">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemTemplate" Value="{StaticResource RadioOptionTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MultiSelect}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource CheckOptionTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- "Other:" row — radio (single-select) or check (multi-
                         select) toggle paired with a free-text TextBox so the
                         user can keep their selection and still type. -->
                    <Grid Margin="8,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0"
                                        Content="{Binding}"
                                        Focusable="False"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource OtherRadioTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MultiSelect}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource OtherCheckTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <TextBox Grid.Column="1"
                                 x:Name="OtherTextBox"
                                 Style="{StaticResource BannerInputTextBoxStyle}"
                                 Text="{Binding OtherText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type your own answer"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 MaxHeight="90"
                                 VerticalScrollBarVisibility="Auto"
                                 MinWidth="80"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource BannerCardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: header strip — chevrons + counter + label -->
            <Grid Grid.Row="0" Margin="8,8,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ChevronButtonStyle}"
                        Command="{Binding GoPrevCommand}"
                        ToolTip="Previous question"
                        Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE76B;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource ChevronButtonStyle}"
                        Command="{Binding GoNextCommand}"
                        ToolTip="Next question"
                        Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <TextBlock Grid.Column="2"
                           Text="{Binding CounterText}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding HeaderLabel}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"
                           Opacity="0.85"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Row 1: separator under the header -->
            <Border Grid.Row="1"
                    Height="1"
                    Margin="0,4,0,0"
                    Opacity="0.5"
                    Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}"/>

            <!-- Row 2: current question host -->
            <ContentControl Grid.Row="2"
                            Content="{Binding CurrentQuestion}"
                            ContentTemplate="{StaticResource QuestionTemplate}"
                            Margin="0,4,0,0"/>

            <!-- Row 3: shortcut hint and submit -->
            <Grid Grid.Row="3" Margin="12,4,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ShortcutHint}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

                <Button Grid.Column="1"
                        Content="{Binding SubmitLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SubmitCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
