<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.Banners.PermissionBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/Banners/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A choice in the "more ways to allow" menu: full width, left
                 aligned, no border, highlighted on hover like a menu item. -->
            <Style x:Key="MenuChoiceButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,6,10,6"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource BannerCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Header}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Margin="12,10,12,4"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding BodyText}"
                       Visibility="{Binding HasBodyText, Converter={StaticResource BoolToVis}}"
                       FontFamily="Consolas, Cascadia Mono, Menlo"
                       FontSize="12"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Opacity="0.7"
                       Margin="12,0,12,8"
                       MaxHeight="160"
                       TextWrapping="Wrap"/>

            <!-- Initial state: Allow / Allow for this session / Deny / Other...
                 in a single row. The session button is hidden when the request
                 gives nothing stable to build a rule from.
                 Clicking Allow or Deny dispatches immediately; Other...
                 swaps the row out for the alternative-input row below. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="6,2,12,10"
                        Visibility="{Binding IsInitialMode, Converter={StaticResource BoolToVis}}">
                <Button Content="Allow"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AllowCommand}"/>
                <!-- Split button. The main half keeps the session allow a single
                     click; the chevron opens the longer-lived and broader
                     choices, which are rarer and more consequential. -->
                <StackPanel x:Name="SessionSplit"
                            Orientation="Horizontal"
                            Visibility="{Binding CanAllowForSession, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="AllowForSessionButton"
                            Content="Allow for this session"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AllowForSessionCommand}"
                            ToolTip="{Binding AllowForSessionTooltip}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="-1,0,0,0"
                            Padding="0"
                            ToolTip="More ways to allow"
                            Click="MoreAllowButton_Click">
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10"
                                   Margin="-6,0"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Button Content="Deny"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DenyCommand}"/>
                <Button Content="Other..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OtherCommand}"/>

                <Popup x:Name="MoreAllowPopup"
                       PlacementTarget="{Binding ElementName=AllowForSessionButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                            BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4"
                            Margin="0,4,0,0">
                        <!-- Each label names both axes, which commands and for how
                             long. The tooltip spells out the rules granted. -->
                        <StackPanel MinWidth="220">
                            <Button Content="Always allow"
                                    Style="{StaticResource MenuChoiceButtonStyle}"
                                    ToolTip="{Binding AllowAlwaysTooltip}"
                                    Click="MoreAllowChoice_Click"
                                    Command="{Binding AllowAlwaysCommand}"/>
                            <Button Content="Allow similar for this session"
                                    Style="{StaticResource MenuChoiceButtonStyle}"
                                    ToolTip="{Binding AllowSimilarForSessionTooltip}"
                                    Visibility="{Binding CanAllowSimilar, Converter={StaticResource BoolToVis}}"
                                    Click="MoreAllowChoice_Click"
                                    Command="{Binding AllowSimilarForSessionCommand}"/>
                            <Button Content="Always allow similar"
                                    Style="{StaticResource MenuChoiceButtonStyle}"
                                    ToolTip="{Binding AllowSimilarAlwaysTooltip}"
                                    Visibility="{Binding CanAllowSimilar, Converter={StaticResource BoolToVis}}"
                                    Click="MoreAllowChoice_Click"
                                    Command="{Binding AllowSimilarAlwaysCommand}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- Other... state: textbox for alternative instructions, Submit
                 sends them as a wrapped deny, the small icon button to the
                 right of Submit returns to the initial state. -->
            <StackPanel Margin="12,2,12,10"
                        Visibility="{Binding IsOtherMode, Converter={StaticResource BoolToVis}}">
                <TextBox Style="{StaticResource BannerInputTextBoxStyle}"
                         Text="{Binding AlternativeText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tell Claude what to do instead"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">
                    <Button Content="Submit"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SubmitCommand}"/>
                    <Button Style="{StaticResource ChevronButtonStyle}"
                            Command="{Binding BackCommand}"
                            ToolTip="Back to Allow / Deny"
                            Margin="6,0,0,0">
                        <TextBlock Text="&#xE112;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
